# ─── Root (should be empty — just in case) ───────────────────────────────────
node_modules/

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
frontend/node_modules
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ─── Backend (NestJS) ─────────────────────────────────────────────────────────
backend/node_modules
backend/dist/
backend/*.tsbuildinfo

# ─── Environment / secrets ───────────────────────────────────────────────────
.env
.env.*
.env*.local
frontend/.env
frontend/.env.*
frontend/.env*.local
backend/.env
backend/.env.*
!backend/.env.example
!frontend/.env.example

# ─── Logs & runtime ──────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
*.pem
.vercel

# ─── Claude internal ─────────────────────────────────────────────────────────
.claude/
