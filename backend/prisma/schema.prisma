generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  BASIC
  PRO
  PRO_PLUS
  PRO_MAX
}

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  COMPLETED
  REJECTED
  MISSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  REMOTE
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  PROCESSED
  FAILED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClaimCategory {
  TRAVEL
  MEALS
  EQUIPMENT
  MEDICAL
  TRAINING
  OTHER
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  AT_RISK
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── Core ─────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        Plan     @default(BASIC)
  logoUrl     String?
  address     String?
  taxId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  departments Department[]
  employees   Employee[]
  payrollRuns PayrollRun[]
  workflows   Workflow[]
  auditLogs   AuditLog[]
  subscription Subscription?

  @@map("organizations")
}

model Subscription {
  id             String   @id @default(cuid())
  orgId          String   @unique
  plan           Plan
  status         String   @default("active") // active | cancelled | past_due
  currentPeriodEnd DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  lastReadMessageId String?
  lastReadAt DateTime?
  orgId        String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee?
  sessions     Session[]
  accounts     Account[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── HR Core ──────────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366F1")
  orgId       String
  headId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([name, orgId])
  @@map("departments")
}

model Employee {
  id             String    @id @default(cuid())
  userId         String    @unique
  orgId          String
  employeeCode   String
  firstName      String
  lastName       String
  email          String
  phone          String?
  avatarUrl      String?
  title          String
  departmentId   String?
  managerId      String?
  employmentType String    @default("Full-time")
  startDate      DateTime
  endDate        DateTime?
  exitReason     String?
  salary         Decimal   @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department     Department? @relation(fields: [departmentId], references: [id])
  manager        Employee?   @relation("Reports", fields: [managerId], references: [id])
  reports        Employee[]  @relation("Reports")

  attendance     AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
  payslips       Payslip[]
  claims         Claim[]
  tasks          Task[]         @relation("AssignedTasks")
  createdTasks   Task[]         @relation("CreatedTasks")
  goals          Goal[]
  reviews        PerformanceReview[] @relation("RevieweeReviews")
  conductedReviews PerformanceReview[] @relation("ReviewerReviews")
  enrollments    CourseEnrollment[]
  certifications EmployeeCertification[]
  onboardings    OnboardingRecord[]
  meetingSlots   MeetingParticipant[]

  @@index([orgId, isActive])
  @@index([orgId, departmentId])
  @@index([orgId, managerId])
  @@unique([employeeCode, orgId])
  @@map("employees")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  hoursWorked Decimal?         @db.Decimal(4, 2)
  notes       String?
  createdAt   DateTime         @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([date])
  @@unique([employeeId, date])
  @@map("attendance_records")
}

// ─── Leave ────────────────────────────────────────────────────────────────────

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  leaveType  LeaveType
  year       Int
  total      Int
  used       Int       @default(0)
  pending    Int       @default(0)
  updatedAt  DateTime  @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  leaveType  LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  days       Int
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// ─── Payroll ──────────────────────────────────────────────────────────────────

model PayrollRun {
  id          String        @id @default(cuid())
  orgId       String
  month       Int
  year        Int
  status      PayrollStatus @default(DRAFT)
  totalGross  Decimal       @db.Decimal(14, 2)
  totalNet    Decimal       @db.Decimal(14, 2)
  totalDeductions Decimal   @db.Decimal(14, 2)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payslips    Payslip[]

  @@unique([orgId, month, year])
  @@map("payroll_runs")
}

model Payslip {
  id           String   @id @default(cuid())
  employeeId   String
  payrollRunId String
  basicSalary  Decimal  @db.Decimal(12, 2)
  hra          Decimal  @db.Decimal(12, 2) @default(0)
  allowances   Decimal  @db.Decimal(12, 2) @default(0)
  grossPay     Decimal  @db.Decimal(12, 2)
  taxDeduction Decimal  @db.Decimal(12, 2) @default(0)
  pfDeduction  Decimal  @db.Decimal(12, 2) @default(0)
  otherDeductions Decimal @db.Decimal(12, 2) @default(0)
  netPay       Decimal  @db.Decimal(12, 2)
  pdfUrl       String?
  createdAt    DateTime @default(now())

  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([employeeId, payrollRunId])
  @@map("payslips")
}

model Claim {
  id          String        @id @default(cuid())
  employeeId  String
  category    ClaimCategory
  amount      Decimal       @db.Decimal(10, 2)
  date        DateTime      @db.Date
  description String
  receiptUrl  String?
  status      ClaimStatus   @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("claims")
}

// ─── Tasks & Projects ────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  orgId       String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @db.Date
  dueDate     DateTime?     @db.Date
  progress    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks       Task[]

  @@index([orgId, status])
  @@map("projects")
}

model Task {
  id          String       @id @default(cuid())
  orgId       String
  projectId   String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  assigneeId  String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project?  @relation(fields: [projectId], references: [id])
  assignee    Employee? @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy   Employee  @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([orgId, status])
  @@index([orgId, assigneeId, status])
  @@index([orgId, dueDate])
  @@map("tasks")
}

// ─── Performance ──────────────────────────────────────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  employeeId  String
  title       String
  description String?
  progress    Int        @default(0)
  status      GoalStatus @default(NOT_STARTED)
  dueDate     DateTime?  @db.Date
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@map("goals")
}

model PerformanceReview {
  id          String       @id @default(cuid())
  revieweeId  String
  reviewerId  String
  period      String
  type        String
  score       Int?
  comments    String?
  status      ReviewStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reviewee    Employee @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer    Employee @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  @@index([revieweeId, status])
  @@index([reviewerId, status])
  @@map("performance_reviews")
}

// ─── Learning ─────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String?
  category    String
  duration    String
  level       String   @default("Beginner")
  thumbnailUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  enrollments CourseEnrollment[]

  @@index([orgId, isActive])
  @@map("courses")
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  courseId    String
  employeeId  String
  progress    Int      @default(0)
  completedAt DateTime?
  enrolledAt  DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@map("course_enrollments")
}

model EmployeeCertification {
  id           String   @id @default(cuid())
  employeeId   String
  name         String
  issuer       String
  credential   String?
  earnedAt     DateTime @db.Date
  expiresAt    DateTime? @db.Date
  createdAt    DateTime @default(now())

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_certifications")
}

// ─── Recruitment ──────────────────────────────────────────────────────────────

model JobPosting {
  id           String   @id @default(cuid())
  orgId        String
  title        String
  department   String
  location     String
  type         String   @default("Full-time")
  description  String?
  requirements String?
  isActive     Boolean  @default(true)
  postedAt     DateTime @default(now())
  closedAt     DateTime?

  candidates   Candidate[]

  @@index([orgId, isActive])
  @@index([orgId, postedAt])
  @@map("job_postings")
}

model Candidate {
  id          String         @id @default(cuid())
  jobId       String
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  stage       CandidateStage @default(APPLIED)
  source      String?
  notes       String?
  appliedAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stage])
  @@index([email])
  @@map("candidates")
}

// ─── Onboarding ───────────────────────────────────────────────────────────────

model OnboardingRecord {
  id         String           @id @default(cuid())
  employeeId String
  status     OnboardingStatus @default(NOT_STARTED)
  startDate  DateTime?        @db.Date
  dueDate    DateTime?        @db.Date
  tasks      Json             @default("[]")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@map("onboarding_records")
}

// ─── Collaboration ────────────────────────────────────────────────────────────

model Channel {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isPrivate Boolean  @default(false)
  createdBy String   // userId of channel creator
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      Message[]
  videoCalls    VideoCall[] @relation("ChannelCalls")
  participants  ChannelParticipant[]

  @@index([orgId, createdAt])
  @@unique([name, orgId])
  @@map("channels")
}

model ChannelParticipant {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  lastReadMessageId String?
  lastReadAt        DateTime?

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([userId, channelId])
  @@index([channelId, lastReadAt])
  @@unique([channelId, userId])
  @@map("channel_participants")
}

model Message {
  id         String   @id @default(cuid())
  channelId  String
  senderId   String
  content    String
  isEdited   Boolean  @default(false)
  createdAt  DateTime @default(now())

  channel    Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([channelId, senderId, createdAt])
  @@map("messages")
}

model DirectConversation {
  id        String          @id @default(cuid())
  orgId     String
  user1Id   String
  user2Id   String
  createdAt DateTime        @default(now())
  
  messages  DirectMessage[]
  videoCalls VideoCall[] @relation("DMCalls")

  @@index([orgId, createdAt])
  @@index([orgId, user1Id])
  @@index([orgId, user2Id])
  @@unique([user1Id, user2Id])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([senderId, createdAt])
  @@map("direct_messages")
}

model VideoCall {
  id                String     @id @default(cuid())
  orgId             String
  callType          String     @default("audio")
  status            CallStatus @default(INITIATED)
  initiatorId       String     // userId
  channelId         String?    // null for DMs
  conversationId    String?    // null for channels
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  createdAt         DateTime   @default(now())

  channel           Channel?           @relation("ChannelCalls", fields: [channelId], references: [id], onDelete: Cascade)
  conversation      DirectConversation? @relation("DMCalls", fields: [conversationId], references: [id], onDelete: Cascade)
  participants      CallParticipant[]

  @@index([orgId, status, createdAt])
  @@index([conversationId])
  @@index([channelId])
  @@map("video_calls")
}

model CallParticipant {
  id       String   @id @default(cuid())
  callId   String
  userId   String
  joinedAt DateTime @default(now())
  leftAt   DateTime?

  call     VideoCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([userId, callId])
  @@unique([callId, userId])
  @@map("call_participants")
}

// ─── Meetings ────────────────────────────────────────────────────────────────

model Meeting {
  id           String   @id @default(cuid())
  orgId        String
  title        String
  type         String   @default("Team")
  scheduledAt  DateTime
  durationMins Int      @default(30)
  platform     String   @default("Zoom")
  meetingUrl   String?
  agenda       String?
  createdById  String
  participants MeetingParticipant[]
  createdAt    DateTime @default(now())

  @@index([orgId, scheduledAt])
  @@index([createdById])
  @@map("meetings")
}

model MeetingParticipant {
  id         String @id @default(cuid())
  meetingId  String
  employeeId String

  meeting  Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, meetingId])
  @@unique([meetingId, employeeId])
  @@map("meeting_participants")
}

// ─── Workflows ────────────────────────────────────────────────────────────────

model Workflow {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  trigger     String
  isEnabled   Boolean  @default(true)
  runsCount   Int      @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, isEnabled])
  @@map("workflows")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  userEmail String
  action    String
  resource  String
  details   String?
  ipAddress String?
  severity  String   @default("Info")
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, severity])
  @@map("audit_logs")
}
