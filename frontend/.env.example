# ─── NextAuth v5 ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── NestJS API (backend) ─────────────────────────────────────────────────────
# Server-side URL used by NextAuth to call the backend
API_URL="http://localhost:3001/api/v1"
# Used in API routes for server-side data fetching
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# Client-side URL for WebSocket connections
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# ─── Google OAuth (optional — enables "Continue with Google" on login page) ───
# Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Groq — primary) ──────────────────────────────────────────────────────
# Get your key at https://console.groq.com (free tier available)
GROQ_API_KEY=""
# Optional: llama-3.3-70b-versatile (default) | llama-3.1-8b-instant (faster, lighter)
# AI_MODEL=""
