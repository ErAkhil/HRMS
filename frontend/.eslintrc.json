{
  "extends": "next/core-web-vitals",
  "rules": {
    "complexity": ["warn", 10],
    "max-depth": ["warn", 4],
    "max-lines": ["warn", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "warn",
      { "max": 50, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
    ]
  }
}
